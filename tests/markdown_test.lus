local ROOT = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")
pledge("load", `fs:read=$ROOT/*`)
package.path = `$ROOT/?.lus;$(package.path)`

local markdown = require("markdown")

-- Each case is { markdown, expected html, name }.
local function check(cases, options)
    local failures = {}
    for _, case in ipairs(cases) do
        local got = markdown.render(case[1], options)
        if got ~= case[2] then
            failures[#failures + 1] = `$(case[3])\n  input:    $(tojson(case[1]))\n  expected: $(tojson(case[2]))\n  got:      $(tojson(got))`
        end
    end
    assert(#failures == 0, table.concat(failures, "\n"))
end

local function headings_test()
    check({
        { "# foo\n## foo\n###### foo\n", "<h1>foo</h1>\n<h2>foo</h2>\n<h6>foo</h6>\n", "atx" },
        { "####### foo\n", "<p>####### foo</p>\n", "seven hashes" },
        { "#5 bolt\n", "<p>#5 bolt</p>\n", "no space" },
        { "# foo ##\n", "<h1>foo</h1>\n", "closing sequence" },
        { "### foo ### b\n", "<h3>foo ### b</h3>\n", "not a closing sequence" },
        { "#\n", "<h1></h1>\n", "empty heading" },
        { "Foo *bar*\n=========\n\nFoo *bar*\n---------\n", "<h1>Foo <em>bar</em></h1>\n<h2>Foo <em>bar</em></h2>\n", "setext" },
        { "Foo\nbar\n===\n", "<h1>Foo\nbar</h1>\n", "multi-line setext" },
    })
end

local function breaks_and_paragraphs_test()
    check({
        { "***\n---\n___\n", "<hr />\n<hr />\n<hr />\n", "thematic breaks" },
        { " - - -\n", "<hr />\n", "spaced break" },
        { "aaa\n\nbbb\n", "<p>aaa</p>\n<p>bbb</p>\n", "two paragraphs" },
        { "aaa\n   bbb\n", "<p>aaa\nbbb</p>\n", "continuation" },
        { "foo  \nbar\n", "<p>foo<br />\nbar</p>\n", "hard break with spaces" },
        { "foo\\\nbar\n", "<p>foo<br />\nbar</p>\n", "hard break with backslash" },
        { "Foo\n***\nbar\n", "<p>Foo</p>\n<hr />\n<p>bar</p>\n", "break interrupts paragraph" },
    })
end

local function code_test()
    check({
        { "    a simple\n      indented code block\n", "<pre><code>a simple\n  indented code block\n</code></pre>\n", "indented" },
        { "```\n<\n >\n```\n", "<pre><code>&lt;\n &gt;\n</code></pre>\n", "fenced" },
        { "~~~ruby startline=3\ndef foo(x)\nend\n~~~\n", "<pre><code class=\"language-ruby\">def foo(x)\nend\n</code></pre>\n", "info string" },
        { "````\naaa\n```\n``````\n", "<pre><code>aaa\n```\n</code></pre>\n", "longer closing fence" },
        { "```\n", "<pre><code></code></pre>\n", "unclosed empty fence" },
        { " ```\n aaa\naaa\n```\n", "<pre><code>aaa\naaa\n</code></pre>\n", "indented fence" },
        { "`foo`\n", "<p><code>foo</code></p>\n", "code span" },
        { "`` foo ` bar ``\n", "<p><code>foo ` bar</code></p>\n", "code span with backtick" },
        { "`  ``  `\n", "<p><code> `` </code></p>\n", "spaces stripped once" },
        { "`foo\\`bar`\n", "<p><code>foo\\</code>bar`</p>\n", "no escapes in code" },
        { "```foo``\n", "<p>```foo``</p>\n", "unmatched run" },
    })
end

local function blockquotes_test()
    check({
        { "> # Foo\n> bar\n> baz\n", "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n", "basic" },
        { "> bar\nbaz\n> foo\n", "<blockquote>\n<p>bar\nbaz\nfoo</p>\n</blockquote>\n", "lazy continuation" },
        { "> foo\n---\n", "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n", "break ends quote" },
        { ">\n", "<blockquote>\n</blockquote>\n", "empty" },
        { "> > > foo\nbar\n", "<blockquote>\n<blockquote>\n<blockquote>\n<p>foo\nbar</p>\n</blockquote>\n</blockquote>\n</blockquote>\n", "nested lazy" },
    })
end

local function lists_test()
    check({
        { "- foo\n- bar\n+ baz\n", "<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<ul>\n<li>baz</li>\n</ul>\n", "bullet change starts a list" },
        { "1. foo\n2. bar\n3) baz\n", "<ol>\n<li>foo</li>\n<li>bar</li>\n</ol>\n<ol start=\"3\">\n<li>baz</li>\n</ol>\n", "ordered" },
        { "- foo\n\n- bar\n", "<ul>\n<li>\n<p>foo</p>\n</li>\n<li>\n<p>bar</p>\n</li>\n</ul>\n", "loose" },
        { "- a\n  - b\n    - c\n", "<ul>\n<li>a\n<ul>\n<li>b\n<ul>\n<li>c</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n", "nested" },
        { "1. a\n\n   b\n", "<ol>\n<li>\n<p>a</p>\n<p>b</p>\n</li>\n</ol>\n", "two paragraphs in an item" },
        { "- foo\n  ```\n  bar\n  ```\n", "<ul>\n<li>foo\n<pre><code>bar\n</code></pre>\n</li>\n</ul>\n", "code in a tight item" },
        { "The number of windows in my house is\n14.  The number of doors is 6.\n", "<p>The number of windows in my house is\n14.  The number of doors is 6.</p>\n", "ordered list must start at 1 to interrupt" },
        { "-\n  foo\n", "<ul>\n<li>foo</li>\n</ul>\n", "item starting with a blank" },
        { "- a\n- b\n\n- c\n", "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n<li>\n<p>c</p>\n</li>\n</ul>\n", "blank between items" },
        { "10. foo\n", "<ol start=\"10\">\n<li>foo</li>\n</ol>\n", "start number" },
        { "- foo\nbar\n", "<ul>\n<li>foo\nbar</li>\n</ul>\n", "lazy item continuation" },
    })
end

local function emphasis_test()
    check({
        { "*foo bar*\n", "<p><em>foo bar</em></p>\n", "em star" },
        { "a * foo bar*\n", "<p>a * foo bar*</p>\n", "not left flanking" },
        { "foo*bar*\n", "<p>foo<em>bar</em></p>\n", "intraword star" },
        { "foo_bar_\n", "<p>foo_bar_</p>\n", "intraword underscore" },
        { "_foo bar_\n", "<p><em>foo bar</em></p>\n", "em underscore" },
        { "**foo bar**\n", "<p><strong>foo bar</strong></p>\n", "strong" },
        { "__foo bar__\n", "<p><strong>foo bar</strong></p>\n", "strong underscore" },
        { "***strong emph***\n", "<p><em><strong>strong emph</strong></em></p>\n", "triple" },
        { "*foo **bar** baz*\n", "<p><em>foo <strong>bar</strong> baz</em></p>\n", "nested" },
        { "**foo*\n", "<p>*<em>foo</em></p>\n", "unbalanced" },
        { "*foo**bar**baz*\n", "<p><em>foo<strong>bar</strong>baz</em></p>\n", "rule of three" },
        { "foo***bar***baz\n", "<p>foo<em><strong>bar</strong></em>baz</p>\n", "intraword triple" },
        { "*(*foo*)*\n", "<p><em>(<em>foo</em>)</em></p>\n", "punctuation" },
        { "\\*not emphasized*\n", "<p>*not emphasized*</p>\n", "escaped" },
        { "~~gone~~ and ~one~\n", "<p><del>gone</del> and <del>one</del></p>\n", "strikethrough" },
    })
end

local function links_test()
    check({
        { "[link](/uri \"title\")\n", "<p><a href=\"/uri\" title=\"title\">link</a></p>\n", "inline" },
        { "[link]()\n", "<p><a href=\"\">link</a></p>\n", "empty destination" },
        { "[link](<foo bar>)\n", "<p><a href=\"foo%20bar\">link</a></p>\n", "pointy destination" },
        { "[link](foo(and(bar)))\n", "<p><a href=\"foo(and(bar))\">link</a></p>\n", "balanced parens" },
        { "[link](foo\\)\\:)\n", "<p><a href=\"foo):\">link</a></p>\n", "escapes in destination" },
        { "[a](<b)c>)\n", "<p><a href=\"b)c\">a</a></p>\n", "paren inside pointy" },
        { "[foo]: /url \"title\"\n\n[foo]\n", "<p><a href=\"/url\" title=\"title\">foo</a></p>\n", "shortcut reference" },
        { "[foo][bar]\n\n[BAR]: /url\n", "<p><a href=\"/url\">foo</a></p>\n", "full reference, case folded" },
        { "[foo][]\n\n[foo]: /url\n", "<p><a href=\"/url\">foo</a></p>\n", "collapsed reference" },
        { "[foo]\n", "<p>[foo]</p>\n", "undefined reference" },
        { "[link *foo **bar** `#`*](/uri)\n", "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>\n", "inlines in text" },
        { "[foo [bar](/uri)](/uri)\n", "<p>[foo <a href=\"/uri\">bar</a>](/uri)</p>\n", "no links in links" },
        { "![foo](/url \"title\")\n", "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n", "image" },
        { "![foo *bar*][foobar]\n\n[FOOBAR]: train.jpg\n", "<p><img src=\"train.jpg\" alt=\"foo bar\" /></p>\n", "image reference alt text" },
        { "<http://foo.bar.baz/test?q=hello&id=22&boolean>\n", "<p><a href=\"http://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean\">http://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean</a></p>\n", "autolink" },
        { "<foo@bar.example.com>\n", "<p><a href=\"mailto:foo@bar.example.com\">foo@bar.example.com</a></p>\n", "email autolink" },
        { "Visit www.commonmark.org/help for more.\n", "<p>Visit <a href=\"http://www.commonmark.org/help\">www.commonmark.org/help</a> for more.</p>\n", "extended www autolink" },
        { "See https://lus.dev/manual.\n", "<p>See <a href=\"https://lus.dev/manual\">https://lus.dev/manual</a>.</p>\n", "extended url autolink" },
        { "[é](/ü)\n", "<p><a href=\"/%C3%BC\">é</a></p>\n", "non-ASCII is encoded" },
    })
end

local function unsafe_links_test()
    check({
        { "[x](javascript:alert(1))\n", "<p><a href=\"\">x</a></p>\n", "javascript removed" },
        { "<javascript:alert(1)>\n", "<p><a href=\"\">javascript:alert(1)</a></p>\n", "javascript autolink removed" },
        { "![x](data:image/png;base64,AAAA)\n", "<p><img src=\"data:image/png;base64,AAAA\" alt=\"x\" /></p>\n", "data image kept" },
        { "[x](data:text/html,hi)\n", "<p><a href=\"\">x</a></p>\n", "data link removed" },
    })
    assert(markdown.render("[x](javascript:go)", { unsafe_links = true }) == "<p><a href=\"javascript:go\">x</a></p>\n")
end

local function html_test()
    check({
        { "<div>\n*hi*\n</div>\n", "<p>&lt;div&gt;\n*hi*\n&lt;/div&gt;</p>\n", "block escaped" },
        { "a <b>bold</b> c\n", "<p>a &lt;b&gt;bold&lt;/b&gt; c</p>\n", "inline escaped" },
    })
    check({
        { "<div>\n*hi*\n</div>\n", "<div>\n*hi*\n</div>\n", "block kept" },
        { "a <b class=\"x\">bold</b> <!-- c -->\n", "<p>a <b class=\"x\">bold</b> <!-- c --></p>\n", "inline kept" },
        { "<script>\nalert(1)\n\n</script>\nafter\n", "<script>\nalert(1)\n\n</script>\n<p>after</p>\n", "script block" },
    }, { html = true })
end

local function entities_and_escapes_test()
    check({
        -- Named references outside the decoding table pass through for the
        -- browser to resolve.
        { "&nbsp; &amp; &copy; &#35; &#x22; &rarr;\n", "<p>\u{A0} &amp; © # &quot; &rarr;</p>\n", "entities" },
        { "&#0; & x&y\n", "<p>\u{FFFD} &amp; x&amp;y</p>\n", "invalid references" },
        { [=[\!\"\#\$\%\&\'\(\)\*\+\,\-\.\/\:\;\<\=\>\?\@\[\\\]\^\_\`\{\|\}\~]=] .. "\n",
          "<p>!&quot;#$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^_`{|}~</p>\n", "every escape" },
        { "\\a\\\n", "<p>\\a\\</p>\n", "not escapes" },
        { "5 < 6 & \"q\"\n", "<p>5 &lt; 6 &amp; &quot;q&quot;</p>\n", "special characters" },
    })
end

local function tables_test()
    check({
        { "| foo | bar |\n| --- | --- |\n| baz | bim |\n",
          "<table>\n<thead>\n<tr>\n<th>foo</th>\n<th>bar</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>baz</td>\n<td>bim</td>\n</tr>\n</tbody>\n</table>\n", "basic table" },
        { "| abc | defghi |\n:-: | -----------:\nbar | baz\n",
          "<table>\n<thead>\n<tr>\n<th align=\"center\">abc</th>\n<th align=\"right\">defghi</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">bar</td>\n<td align=\"right\">baz</td>\n</tr>\n</tbody>\n</table>\n", "alignment" },
        { "| f\\|oo  |\n| ------ |\n| b `x` **im** |\n",
          "<table>\n<thead>\n<tr>\n<th>f|oo</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b <code>x</code> <strong>im</strong></td>\n</tr>\n</tbody>\n</table>\n", "escaped pipe and inlines" },
        { "| abc | def |\n| --- |\n| bar |\n", "<p>| abc | def |\n| --- |\n| bar |</p>\n", "column count must match" },
        { "| abc | def |\n| --- | --- |\n| bar |\n| bar | baz | boo |\n",
          "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n", "short and long rows" },
    })
end

local function task_lists_test()
    check({
        { "- [ ] foo\n- [x] bar\n", "<ul>\n<li><input disabled=\"\" type=\"checkbox\" /> foo</li>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\" /> bar</li>\n</ul>\n", "tasks" },
    })
    assert(markdown.render("- [x] a", { tasks = false }) == "<ul>\n<li>[x] a</li>\n</ul>\n")
end

local function tree_test()
    local tree = markdown.parse("# Title\n\nSome *text* with [a link](/x).\n")
    assert(tree.type == "document")
    assert(tree.children[1].type == "heading" and tree.children[1].level == 1)
    local para = tree.children[2]
    assert(para.type == "paragraph" and para.children[2].type == "emph")
    assert(para.children[4].type == "link" and para.children[4].dest == "/x")
    -- A program may change the tree before rendering it.
    para.children[4].dest = "/y"
    assert(markdown.html(tree):find('href="/y"', 1, true))
end

local function any_input_renders_test()
    local samples = { "", "\n\n", "[", "*", "**", "`", "<", "&", "> ", "- ", "1.", "|", "```", "\\", "![", "[a](", "\0", "\t\tx", "# \n#", "[]: x" }
    for _, s in ipairs(samples) do
        assert(type(markdown.render(s)) == "string", tojson(s))
    end
end

local function tabs_test()
    check({
        { "\tfoo\tbaz\t\tbim\n", "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n", "tab indent" },
        { "-\tfoo\n", "<ul>\n<li>foo</li>\n</ul>\n", "tab after marker" },
    })
end
